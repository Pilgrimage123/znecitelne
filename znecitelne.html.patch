@@ overlap resolution
+function resolveVisibleHits(hits) {
+  const ordered = (hits || [])
+    .filter(h => h && Number.isFinite(h.start) && Number.isFinite(h.end))
+    .filter(h => h.end > h.start)
+    .slice()
+    .sort((a, b) =>
+      a.start - b.start ||
+      b.end - a.end ||
+      (a.id || 0) - (b.id || 0)
+    );
+
+  const chosen = [];
+  let lastEnd = -1;
+
+  for (const h of ordered) {
+    if (h.start < lastEnd) continue;
+    chosen.push(h);
+    lastEnd = h.end;
+  }
+
+  return chosen;
+}
+
+function effectiveHits(hits) {
+  return resolveVisibleHits(
+    (hits || []).filter(h => h.accept)
+  );
+}
+
+function pdfAssetPath(relativePath) {
+  return new URL(`./lib/${relativePath}`, window.location.href).href;
+}
+
+function configurePdfJs() {
+  if (typeof pdfjsLib === 'undefined') {
+    throw new Error('PDF.js library is not loaded');
+  }
+
+  pdfWorker();
+
+  return {
+    cMapUrl: pdfAssetPath('cmaps/'),
+    cMapPacked: true
+  };
+}
+
+function pdfDocumentOptions(options = {}) {
+  return {
+    ...configurePdfJs(),
+    ...options
+  };
+}
+
+function apply(text, hits, mode, lang) {
+  const effective = effectiveHits(hits);
+  const replacer = makeReplacer(mode, lang);
+  let out = text;
+
+  for (const h of effective.slice().sort((a, b) => b.start - a.start)) {
+    out =
+      out.slice(0, h.start) +
+      replacer(h) +
+      out.slice(h.end);
+  }
+
+  return out;
+}

@@ batch export cleanup
+// Around each batch item, ensure transient export state is cleared:
